# Copy this file to .env.local. Never commit or share the completed file.
# On macOS, the local setup page stores provider keys in Keychain instead. These
# fields remain available for development and non-macOS installations.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Provider endpoints and model defaults. Override a model without changing code.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

# Local research sources.
ZOTERO_LOCAL_URL=http://127.0.0.1:23119
OBSIDIAN_VAULT_PATH="/absolute/path/to/your/Obsidian/vault"

# Exact origins allowed to use this Mac's bridge, including the fixed Vercel backup.
# Add other deployed origins comma-separated. Wildcards are intentionally unsupported,
# and every origin must be https unless it is this computer's own http://localhost.
# Local development servers are not trusted by default: whatever listens on such a
# port could use the Bridge. `npm run setup -- --dev` adds them for contributors.
SCHOLARBUDDY_ORIGINS=https://scholarbuddy.tech,https://www.scholarbuddy.tech,https://scholarbuddy-eta.vercel.app

# Public because the browser must know which loopback port to call. The bridge
# also reads this value, so one setting keeps both sides aligned.
NEXT_PUBLIC_SCHOLARBUDDY_BRIDGE_PORT=32145

# Optional limits. Each site receives its own credential when a browser pairs.
SCHOLARBUDDY_AI_MAX_CONCURRENT=1
SCHOLARBUDDY_AI_REQUESTS_PER_10_MIN=10
SCHOLARBUDDY_AI_DAILY_TOKENS=50000
SCHOLARBUDDY_AI_MAX_OUTPUT_TOKENS=2400
