# Copy this file to .env.local. Never commit or share the completed file.
# On macOS, the local setup page stores provider keys in Keychain instead. These
# fields remain available for development and non-macOS installations.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Provider endpoints and model defaults. Override a model without changing code.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

# Local research sources.
ZOTERO_LOCAL_URL=http://127.0.0.1:23119
OBSIDIAN_VAULT_PATH="/absolute/path/to/your/Obsidian/vault"

# Exact origins allowed to use this Mac's bridge. Add each deployed origin after
# publishing, comma-separated. Wildcards are intentionally unsupported.
WORKBUDDY_ORIGINS=https://scholarbuddy.yangstal1030.chatgpt.site,https://scholarbuddy.tech,http://localhost:3000,http://localhost:5173,http://localhost:4173

# Public because the browser must know which loopback port to call. The bridge
# also reads this value, so one setting keeps both sides aligned.
NEXT_PUBLIC_WORKBUDDY_BRIDGE_PORT=32145

# Optional limits. The bridge creates its own private pairing token automatically.
WORKBUDDY_AI_MAX_CONCURRENT=1
WORKBUDDY_AI_REQUESTS_PER_10_MIN=10
WORKBUDDY_AI_DAILY_TOKENS=50000
WORKBUDDY_AI_MAX_OUTPUT_TOKENS=2400
